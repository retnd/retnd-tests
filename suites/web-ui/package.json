{
  "name": "@rclone-manager-tests/web-ui",
  "private": true,
  "type": "module",
  "description": "Suite B: the Web UI Playwright suite, migrated out of rclone-manager's ui/shared/e2e.",
  "scripts": {
    "e2e": "playwright test --project=generic --project=small-window",
    "e2e:list": "playwright test --list --project=generic --project=small-window",
    "e2e:ui": "playwright test --ui",
    "e2e:providers": "playwright test --project=providers",
    "e2e:all-providers": "node scripts/e2e-all-providers.mjs",
    "unit": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@playwright/test": "^1.47.0",
    "@types/node": "^22.20.1",
    "typescript": "^5.9.3",
    "vitest": "^2.1.0"
  }
}
